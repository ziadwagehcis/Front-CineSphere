<%- include('../../partials/siteHeader', { pageTitle }) %>

<div class="container form-page-container">
    <div class="form-wrapper">
        <div class="form-header">
            <span class="form-badge">MongoDB Document: <%= movie._id %></span>
            <h1 class="form-title">Edit Movie</h1>
            <p class="form-subtitle">Update movie metadata, adjust genres, or provide a hosted poster URL.</p>
        </div>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert-banner alert-danger">
                <span class="alert-icon">⚠</span>
                <span><%= errorMessage %></span>
            </div>
        <% } %>

        <form action="/movies/update" method="post" class="modern-form" id="updateMovieForm">
            <input type="hidden" name="id" value="<%= movie._id %>">

            <div class="form-grid">
                <!-- Title -->
                <div class="form-group span-2">
                    <label for="titleInput">Movie Title <span class="req">*</span></label>
                    <input 
                        type="text" 
                        id="titleInput" 
                        name="title" 
                        value="<%= movie.title %>"
                        maxlength="150"
                        required 
                        autocomplete="off"
                    >
                </div>

                <!-- Year -->
                <div class="form-group">
                    <label for="yearInput">Release Year <span class="req">*</span></label>
                    <input 
                        type="number" 
                        id="yearInput" 
                        name="year" 
                        min="1888" 
                        max="<%= new Date().getFullYear() + 5 %>" 
                        value="<%= movie.year %>" 
                        required
                    >
                </div>

                <!-- Rating -->
                <div class="form-group">
                    <label for="ratingInput">Rating (0.0 - 10.0)</label>
                    <input 
                        type="number" 
                        id="ratingInput" 
                        name="rating" 
                        step="0.1" 
                        min="0" 
                        max="10" 
                        value="<%= movie.rating || 7.5 %>"
                    >
                </div>

                <!-- Director -->
                <div class="form-group">
                    <label for="directorInput">Director</label>
                    <input 
                        type="text" 
                        id="directorInput" 
                        name="director" 
                        value="<%= movie.director || '' %>"
                    >
                </div>

                <!-- Duration -->
                <div class="form-group">
                    <label for="durationInput">Runtime</label>
                    <input 
                        type="text" 
                        id="durationInput" 
                        name="duration" 
                        value="<%= movie.duration || '' %>"
                    >
                </div>

                <!-- Cast -->
                <div class="form-group span-2">
                    <label for="castInput">Cast Members <span class="req">*</span></label>
                    <input 
                        type="text" 
                        id="castInput" 
                        name="cast" 
                        value="<%= (movie.cast || []).join(', ') %>"
                        required 
                    >
                    <span class="field-hint">Comma separated list of main actors.</span>
                </div>

                <!-- Genres Picker -->
                <div class="form-group span-2">
                    <label>Genres <span class="req">*</span></label>
                    <span class="field-hint">Click genres to add or remove them.</span>

                    <div class="genre-picker" id="genrePicker">
                        <% 
                        const allGenresList = [
                            "Action", "Adventure", "Animation", "Biography", "Comedy", 
                            "Crime", "Documentary", "Drama", "Family", "Fantasy", 
                            "History", "Horror", "Music", "Musical", "Mystery", 
                            "Romance", "Sci-Fi", "Sport", "Thriller", "War", "Western"
                        ];
                        const selectedGenres = movie.genres || [];
                        allGenresList.forEach(genre => { 
                            const isSelected = selectedGenres.includes(genre);
                        %>
                            <button 
                                type="button" 
                                class="genre-pill-btn <%= isSelected ? 'selected' : '' %>" 
                                data-genre="<%= genre %>"
                            >
                                <span class="plus-sign"><%= isSelected ? '✓' : '+' %></span> <%= genre %>
                            </button>
                        <% }) %>
                    </div>

                    <!-- Selected Genres Box -->
                    <div class="selected-genres-panel">
                        <span class="selected-label">Selected:</span>
                        <div class="selected-genres-box" id="selectedGenresBox">
                            <% selectedGenres.forEach(genre => { %>
                                <span class="selected-tag" data-name="<%= genre %>">
                                    <span><%= genre %></span>
                                    <button type="button" class="tag-remove" data-remove="<%= genre %>" title="Remove <%= genre %>">&times;</button>
                                </span>
                            <% }) %>
                            <% if (selectedGenres.length === 0) { %>
                                <span class="no-genres-hint" id="noGenresHint">No genres selected.</span>
                            <% } %>
                        </div>
                    </div>

                    <div id="hiddenGenreInputs">
                        <% selectedGenres.forEach(genre => { %>
                            <input type="hidden" name="genres" value="<%= genre %>" data-name="<%= genre %>">
                        <% }) %>
                    </div>
                </div>

                <!-- Storyline -->
                <div class="form-group span-2">
                    <label for="descInput">Storyline / Synopsis</label>
                    <textarea 
                        id="descInput" 
                        name="description" 
                        rows="4" 
                    ><%= movie.description || '' %></textarea>
                </div>

                <!-- Poster Image Section -->
                <div class="form-group span-2 poster-input-section">
                    <label>Movie Poster</label>
                    <span class="field-hint">Provide a public image URL. Leave blank to keep the current poster.</span>

                    <div class="poster-input-grid">
                        <div class="poster-fields">
                            <div class="sub-input-group">
                                <label for="urlInput" class="sub-label">Poster Image URL</label>
                                <input 
                                    type="url" 
                                    id="urlInput" 
                                    name="thumbnailUrl" 
                                    value="<%= (movie.thumbnail || movie.poster || '').startsWith('http://') || (movie.thumbnail || movie.poster || '').startsWith('https://') ? (movie.thumbnail || movie.poster) : '' %>"
                                    placeholder="https://image.tmdb.org/t/p/w500/..."
                                >
                            </div>
                        </div>

                        <!-- Live Preview Frame -->
                        <div class="poster-preview-card">
                            <div class="preview-label">Current Poster Preview</div>
                            <div class="poster-preview-box">
                                <img 
                                    id="posterPreviewImg" 
                                    src="<%= getMoviePoster(movie.thumbnail, movie.poster) %>" 
                                    alt="Poster Preview"
                                    onerror="this.onerror=null;this.src='/img/placeholder-poster.svg';"
                                >
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="form-footer-actions">
                <button type="submit" class="btn btn-primary btn-lg">
                    <span>Update Movie</span>
                </button>
                <a href="/movies/show/<%= movie._id %>" class="btn btn-secondary btn-lg">Cancel</a>
            </div>

        </form>
    </div>
</div>

<script>
(function() {
    const picker = document.getElementById('genrePicker');
    const box = document.getElementById('selectedGenresBox');
    const hiddenInputs = document.getElementById('hiddenGenreInputs');

    function hasGenre(name) {
        return !!hiddenInputs.querySelector(`input[data-name="${CSS.escape(name)}"]`);
    }

    function addGenre(name) {
        if (hasGenre(name)) return;

        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'genres';
        input.value = name;
        input.dataset.name = name;
        hiddenInputs.appendChild(input);

        const tag = document.createElement('span');
        tag.className = 'selected-tag';
        tag.dataset.name = name;
        tag.innerHTML = `<span>${name}</span><button type="button" class="tag-remove" title="Remove ${name}">&times;</button>`;
        tag.querySelector('.tag-remove').addEventListener('click', () => removeGenre(name));
        box.appendChild(tag);

        const btn = picker.querySelector(`button[data-genre="${CSS.escape(name)}"]`);
        if (btn) {
            btn.classList.add('selected');
            const sign = btn.querySelector('.plus-sign');
            if (sign) sign.textContent = '✓';
        }
    }

    function removeGenre(name) {
        const input = hiddenInputs.querySelector(`input[data-name="${CSS.escape(name)}"]`);
        if (input) input.remove();

        const tag = box.querySelector(`.selected-tag[data-name="${CSS.escape(name)}"]`);
        if (tag) tag.remove();

        const btn = picker.querySelector(`button[data-genre="${CSS.escape(name)}"]`);
        if (btn) {
            btn.classList.remove('selected');
            const sign = btn.querySelector('.plus-sign');
            if (sign) sign.textContent = '+';
        }
    }

    picker.querySelectorAll('.genre-pill-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const genre = this.dataset.genre;
            if (hasGenre(genre)) {
                removeGenre(genre);
            } else {
                addGenre(genre);
            }
        });
    });

    box.querySelectorAll('.tag-remove').forEach(btn => {
        btn.addEventListener('click', function() {
            const genre = this.dataset.remove || this.parentElement.dataset.name;
            removeGenre(genre);
        });
    });

    // Poster Live Preview
    const urlInput = document.getElementById('urlInput');
    const previewImg = document.getElementById('posterPreviewImg');
    const defaultSrc = previewImg.src;

    if (urlInput) {
        urlInput.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.startsWith('http://') || val.startsWith('https://')) {
                previewImg.src = val;
            } else if (!val) {
                previewImg.src = defaultSrc;
            }
        });
    }

    previewImg.addEventListener('error', function() {
        this.src = '/img/placeholder-poster.svg';
    });
})();
</script>

<%- include('../../partials/siteFooter') %>

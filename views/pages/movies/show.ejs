<%- include('../../partials/siteHeader', { pageTitle }) %>

<div class="container movie-details-container">

    <!-- Flash Alert -->
    <% if (typeof alert !== 'undefined' && alert) { %>
        <% if (alert === 'created') { %>
            <div class="alert-banner alert-success">
                <span class="alert-icon">✓</span>
                <span><strong>Success!</strong> Movie created and saved to MongoDB.</span>
            </div>
        <% } else if (alert === 'updated') { %>
            <div class="alert-banner alert-info">
                <span class="alert-icon">✓</span>
                <span><strong>Updated!</strong> Movie details have been saved successfully.</span>
            </div>
        <% } %>
    <% } %>

    <% if (movie) { %>

        <!-- Breadcrumbs -->
        <nav class="breadcrumb-nav">
            <a href="/">Home</a>
            <span class="breadcrumb-sep">/</span>
            <% if (movie.genres && movie.genres[0]) { %>
                <a href="/?genre=<%= encodeURIComponent(movie.genres[0]) %>"><%= movie.genres[0] %></a>
                <span class="breadcrumb-sep">/</span>
            <% } %>
            <span class="breadcrumb-current"><%= movie.title %></span>
        </nav>

        <!-- Movie Hero / Details Showcase -->
        <section class="details-showcase">
            <!-- Background Ambient Glow -->
            <div 
                class="details-backdrop-ambient" 
                style="background-image: url('<%= getMoviePoster(movie.thumbnail, movie.poster) %>');"
            ></div>

            <div class="details-grid">
                <!-- Poster Column -->
                <div class="details-poster-col">
                    <div class="details-poster-frame">
                        <img 
                            src="<%= getMoviePoster(movie.thumbnail, movie.poster) %>" 
                            alt="<%= movie.title %>"
                            class="details-poster-img"
                            onerror="this.onerror=null;this.src='/img/placeholder-poster.svg';"
                        >
                    </div>

                    <!-- Side action buttons -->
                    <div class="details-poster-actions">
                        <a href="/movies/edit/<%= movie._id %>" class="btn btn-primary btn-block">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            <span>Edit Movie</span>
                        </a>

                        <form 
                            action="/movies/delete/<%= movie._id %>" 
                            method="post"
                            onsubmit="return confirm('Are you sure you want to permanently delete this movie?');"
                            style="margin: 0; width: 100%;"
                        >
                            <button type="submit" class="btn btn-danger btn-block">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                <span>Delete Movie</span>
                            </button>
                        </form>

                        <a href="/" class="btn btn-secondary btn-block">
                            &larr; Back to Catalog
                        </a>
                    </div>
                </div>

                <!-- Info Column -->
                <div class="details-info-col">
                    <div class="details-header">
                        <h1 class="details-title"><%= movie.title %></h1>
                        <span class="details-year-tag"><%= movie.year %></span>
                    </div>

                    <!-- Meta Badges Bar -->
                    <div class="details-meta-bar">
                        <div class="meta-rating-box">
                            <span class="meta-star">★</span>
                            <div class="meta-score">
                                <strong><%= movie.rating ? Number(movie.rating).toFixed(1) : '7.5' %></strong>
                                <span>/ 10</span>
                            </div>
                        </div>

                        <% if (movie.duration) { %>
                            <div class="meta-info-item">
                                <span class="meta-info-label">Runtime</span>
                                <span class="meta-info-value"><%= movie.duration %></span>
                            </div>
                        <% } %>

                        <% if (movie.director) { %>
                            <div class="meta-info-item">
                                <span class="meta-info-label">Director</span>
                                <span class="meta-info-value"><%= movie.director %></span>
                            </div>
                        <% } %>

                        <div class="meta-info-item">
                            <span class="meta-info-label">Release Year</span>
                            <a href="/?year=<%= movie.year %>" class="meta-info-link"><%= movie.year %></a>
                        </div>
                    </div>

                    <!-- Genre Pills -->
                    <div class="details-genres">
                        <span class="details-label">Genres</span>
                        <div class="genre-pill-group">
                            <% (movie.genres || []).forEach(g => { %>
                                <a href="/?genre=<%= encodeURIComponent(g) %>" class="details-genre-pill">
                                    <%= g %>
                                </a>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Storyline -->
                    <div class="details-storyline-section">
                        <h3 class="details-section-heading">Storyline</h3>
                        <p class="details-storyline-text">
                            <%= movie.description || "No synopsis available for this title yet. You can edit this movie to add a rich plot summary." %>
                        </p>
                    </div>

                    <!-- Cast & Characters -->
                    <div class="details-cast-section">
                        <h3 class="details-section-heading">Top Cast</h3>
                        <% if (movie.cast && movie.cast.length > 0) { %>
                            <div class="cast-pill-grid">
                                <% movie.cast.forEach(actor => { %>
                                    <a href="/?cast=<%= encodeURIComponent(actor) %>" class="cast-pill">
                                        <span class="cast-avatar">👤</span>
                                        <span class="cast-name"><%= actor %></span>
                                    </a>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="cast-empty">No cast information listed.</p>
                        <% } %>
                    </div>

                    <!-- MongoDB Object Info -->
                    <div class="details-tech-info">
                        <span>Database ID: <code><%= movie._id %></code></span>
                        <% if (movie.createdAt) { %>
                            <span>Added: <%= new Date(movie.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>

        <!-- Related Movies Section -->
        <% if (relatedMovies && relatedMovies.length > 0) { %>
            <section class="related-section">
                <div class="section-header">
                    <div class="section-title-wrap">
                        <h2 class="section-heading">Similar Movies &amp; Top Picks</h2>
                        <span class="section-count">Matched by genre, cast, director, or rating</span>
                    </div>
                </div>

                <div class="movie-grid related-grid">
                    <% relatedMovies.forEach(rel => { %>
                        <article class="movie-card">
                            <div class="movie-card-poster-wrap">
                                <a href="/movies/show/<%= rel._id %>">
                                    <img
                                        src="<%= getMoviePoster(rel.thumbnail, rel.poster) %>"
                                        alt="<%= rel.title %>"
                                        class="movie-card-poster"
                                        loading="lazy"
                                        onerror="this.onerror=null;this.src='/img/placeholder-poster.svg';"
                                    >
                                </a>
                                <% if (rel.rating) { %>
                                    <div class="card-rating-badge">
                                        <span class="star">★</span> <%= Number(rel.rating).toFixed(1) %>
                                    </div>
                                <% } %>
                                <div class="card-year-badge"><%= rel.year %></div>
                            </div>
                            <div class="movie-card-body">
                                <h3 class="movie-card-title">
                                    <a href="/movies/show/<%= rel._id %>"><%= rel.title %></a>
                                </h3>
                                <% if (rel.recommendationReason) { %>
                                    <p class="recommendation-reason"><%= rel.recommendationReason %></p>
                                <% } %>
                                <div class="movie-card-genres">
                                    <% (rel.genres || []).slice(0, 2).forEach(g => { %>
                                        <a href="/?genre=<%= encodeURIComponent(g) %>" class="card-genre-pill"><%= g %></a>
                                    <% }) %>
                                </div>
                                <div class="movie-card-actions">
                                    <a href="/movies/show/<%= rel._id %>" class="btn-card-action btn-card-details">Details</a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>
        <% } %>

    <% } else { %>
        <!-- Movie Not Found -->
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <h2 class="empty-title">Movie Not Found</h2>
            <p class="empty-desc">
                The movie you are looking for does not exist in the database or may have been deleted.
            </p>
            <div class="empty-actions">
                <a href="/" class="btn btn-primary btn-md">Back to Home</a>
                <a href="/movies/create" class="btn btn-secondary btn-md">+ Add Movie</a>
            </div>
        </div>
    <% } %>

</div>

<%- include('../../partials/siteFooter') %>

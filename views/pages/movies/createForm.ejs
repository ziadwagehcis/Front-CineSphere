<%- include('../../partials/siteHeader', { pageTitle }) %>

<div class="container form-page-container">
    <div class="form-wrapper">
        <div class="form-header">
            <span class="form-badge">+ Add To MongoDB</span>
            <h1 class="form-title">Create New Movie</h1>
            <p class="form-subtitle">Enter movie details, assign genres, and link a hosted poster image.</p>
        </div>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert-banner alert-danger">
                <span class="alert-icon">⚠</span>
                <span><%= errorMessage %></span>
            </div>
        <% } %>

        <form action="/movies" method="post" class="modern-form" id="movieForm">
            
            <div class="form-grid">
                <!-- Title -->
                <div class="form-group span-2">
                    <label for="titleInput">Movie Title <span class="req">*</span></label>
                    <input 
                        type="text" 
                        id="titleInput" 
                        name="title" 
                        maxlength="150"
                        required 
                        placeholder="e.g. Inception, Interstellar, The Godfather"
                        autocomplete="off"
                    >
                </div>

                <!-- Year -->
                <div class="form-group">
                    <label for="yearInput">Release Year <span class="req">*</span></label>
                    <input 
                        type="number" 
                        id="yearInput" 
                        name="year" 
                        min="1888" 
                        max="<%= new Date().getFullYear() + 5 %>" 
                        value="<%= new Date().getFullYear() %>" 
                        required
                    >
                </div>

                <!-- Rating -->
                <div class="form-group">
                    <label for="ratingInput">Rating (0.0 - 10.0)</label>
                    <input 
                        type="number" 
                        id="ratingInput" 
                        name="rating" 
                        step="0.1" 
                        min="0" 
                        max="10" 
                        value="8.0" 
                        placeholder="e.g. 8.8"
                    >
                </div>

                <!-- Director -->
                <div class="form-group">
                    <label for="directorInput">Director</label>
                    <input 
                        type="text" 
                        id="directorInput" 
                        name="director" 
                        placeholder="e.g. Christopher Nolan, Denis Villeneuve"
                    >
                </div>

                <!-- Duration -->
                <div class="form-group">
                    <label for="durationInput">Runtime</label>
                    <input 
                        type="text" 
                        id="durationInput" 
                        name="duration" 
                        placeholder="e.g. 148 min, 2h 28m"
                    >
                </div>

                <!-- Cast -->
                <div class="form-group span-2">
                    <label for="castInput">Cast Members <span class="req">*</span></label>
                    <input 
                        type="text" 
                        id="castInput" 
                        name="cast" 
                        required 
                        placeholder="Separate actors with commas: Leonardo DiCaprio, Tom Hardy, Elliot Page"
                    >
                    <span class="field-hint">Comma separated list of main actors.</span>
                </div>

                <!-- Genres Picker -->
                <div class="form-group span-2">
                    <label>Genres <span class="req">*</span></label>
                    <span class="field-hint">Click genres to toggle them for this movie.</span>

                    <div class="genre-picker" id="genrePicker">
                        <% 
                        const allGenresList = [
                            "Action", "Adventure", "Animation", "Biography", "Comedy", 
                            "Crime", "Documentary", "Drama", "Family", "Fantasy", 
                            "History", "Horror", "Music", "Musical", "Mystery", 
                            "Romance", "Sci-Fi", "Sport", "Thriller", "War", "Western"
                        ];
                        allGenresList.forEach(genre => { 
                        %>
                            <button type="button" class="genre-pill-btn" data-genre="<%= genre %>">
                                <span class="plus-sign">+</span> <%= genre %>
                            </button>
                        <% }) %>
                    </div>

                    <!-- Selected Genres Container -->
                    <div class="selected-genres-panel">
                        <span class="selected-label">Selected:</span>
                        <div class="selected-genres-box" id="selectedGenresBox">
                            <span class="no-genres-hint" id="noGenresHint">No genres selected yet. Click above to add.</span>
                        </div>
                    </div>
                    <div id="hiddenGenreInputs"></div>
                </div>

                <!-- Storyline -->
                <div class="form-group span-2">
                    <label for="descInput">Storyline / Synopsis</label>
                    <textarea 
                        id="descInput" 
                        name="description" 
                        rows="4" 
                        placeholder="Brief overview or plot summary of the movie..."
                    ></textarea>
                </div>

                <!-- Poster Image Section -->
                <div class="form-group span-2 poster-input-section">
                    <label>Movie Poster</label>
                    <span class="field-hint">Use a public image URL so the poster remains available after deployment.</span>

                    <div class="poster-input-grid">
                        <div class="poster-fields">
                            <div class="sub-input-group">
                                <label for="urlInput" class="sub-label">Poster Image URL</label>
                                <input 
                                    type="url" 
                                    id="urlInput" 
                                    name="thumbnailUrl" 
                                    placeholder="https://image.tmdb.org/t/p/w500/..."
                                >
                            </div>
                        </div>

                        <!-- Live Preview Frame -->
                        <div class="poster-preview-card">
                            <div class="preview-label">Live Poster Preview</div>
                            <div class="poster-preview-box">
                                <img 
                                    id="posterPreviewImg" 
                                    src="/img/placeholder-poster.svg" 
                                    alt="Poster Preview"
                                >
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="form-footer-actions">
                <button type="submit" class="btn btn-primary btn-lg">
                    <span>Create Movie</span>
                </button>
                <a href="/" class="btn btn-secondary btn-lg">Cancel</a>
            </div>

        </form>
    </div>
</div>

<script>
(function() {
    // Genre Selector Logic
    const picker = document.getElementById('genrePicker');
    const box = document.getElementById('selectedGenresBox');
    const hiddenInputs = document.getElementById('hiddenGenreInputs');
    const noHint = document.getElementById('noGenresHint');

    function hasGenre(name) {
        return !!hiddenInputs.querySelector(`input[value="${CSS.escape(name)}"]`);
    }

    function addGenre(name) {
        if (hasGenre(name)) return;

        if (noHint) noHint.style.display = 'none';

        // Add hidden input
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'genres';
        input.value = name;
        input.dataset.name = name;
        hiddenInputs.appendChild(input);

        // Add visual tag
        const tag = document.createElement('span');
        tag.className = 'selected-tag';
        tag.dataset.name = name;
        tag.innerHTML = `<span>${name}</span><button type="button" class="tag-remove" title="Remove ${name}">&times;</button>`;
        tag.querySelector('.tag-remove').addEventListener('click', () => removeGenre(name));
        box.appendChild(tag);

        // Update picker button style
        const btn = picker.querySelector(`button[data-genre="${CSS.escape(name)}"]`);
        if (btn) btn.classList.add('selected');
    }

    function removeGenre(name) {
        const input = hiddenInputs.querySelector(`input[value="${CSS.escape(name)}"]`);
        if (input) input.remove();

        const tag = box.querySelector(`.selected-tag[data-name="${CSS.escape(name)}"]`);
        if (tag) tag.remove();

        const btn = picker.querySelector(`button[data-genre="${CSS.escape(name)}"]`);
        if (btn) btn.classList.remove('selected');

        if (hiddenInputs.querySelectorAll('input').length === 0 && noHint) {
            noHint.style.display = 'inline';
        }
    }

    picker.querySelectorAll('.genre-pill-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const genre = this.dataset.genre;
            if (hasGenre(genre)) {
                removeGenre(genre);
            } else {
                addGenre(genre);
            }
        });
    });

    // Default select first genre if empty
    addGenre("Action");

    // Poster Live Preview Logic
    const urlInput = document.getElementById('urlInput');
    const previewImg = document.getElementById('posterPreviewImg');

    if (urlInput) {
        urlInput.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.startsWith('http://') || val.startsWith('https://')) {
                previewImg.src = val;
            } else if (!val) {
                previewImg.src = '/img/placeholder-poster.svg';
            }
        });
    }

    previewImg.addEventListener('error', function() {
        this.src = '/img/placeholder-poster.svg';
    });
})();
</script>

<%- include('../../partials/siteFooter') %>
